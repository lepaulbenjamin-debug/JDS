node_modules/
.env
.env.local
*.log
.DS_Store

dist/

# Sortie de scripts/generate-questions.mjs : un brouillon à relire, pas une source.
scripts/questions-brouillon.json

# Les clips d'essai de `generate-audio.mjs --blanc` : du silence, lourd et sans
# intérêt. Les vrais enregistrements, eux, sont versionnés — quelques mégaoctets
# de MP3 servis par le CDN, et surtout la certitude que la voix est là en
# production. Un déploiement sans clips retomberait sur la synthèse du
# navigateur, c'est-à-dire sur le défaut qu'on a passé une soirée à corriger.
web/quiz/audio/**/*.wav

# Le projet natif est maintenant VERSIONNÉ, et ce n'est plus le même choix
# qu'au début. La raison : la configuration Xcode — les fichiers Swift dans la
# cible, la capacité « Sign in with Apple », le schéma d'URL de Google — ne se
# rejoue pas automatiquement. Un `cap add ios` neuf donne un projet qui compile
# et se publie très bien SANS rien de tout cela, en silence. La construire une
# fois puis la versionner est la seule façon d'en faire quelque chose de
# reproductible, et c'est ce que le workflow iOS attend.
#
# Ce qui reste ignoré : le paquet web recopié à chaque build par `cap sync`, et
# les artefacts de compilation. Aucun secret de signature n'y est écrit — la CI
# signe avec une clé d'API, et un développeur avec son propre compte.
ios/App/App/public/
ios/App/build/
ios/DerivedData/
android/

# Les clips d'essai des packs : du silence, comme ceux de la banque de base.
packs/audio/blanc/
