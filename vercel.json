{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "dist/web",
  "rewrites": [
    {
      "source": "/confidentialite",
      "destination": "/confidentialite.html"
    },
    {
      "source": "/assistance",
      "destination": "/assistance.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/merci",
      "destination": "/merci.html"
    }
  ],
  "redirects": [
    {
      "source": "/quiz",
      "destination": "/jouer/",
      "permanent": false
    },
    {
      "source": "/quiz/(.*)",
      "destination": "/jouer/$1",
      "permanent": false
    }
  ],
  "functions": {
    "api/packs.mjs": {
      "includeFiles": "{packs/**,certs/**}"
    }
  }
}
