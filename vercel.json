{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "dist/web",
  "redirects": [
    { "source": "/quiz", "destination": "/", "permanent": false },
    { "source": "/quiz/:chemin*", "destination": "/:chemin*", "permanent": false }
  ],
  "functions": {
    "api/scan.mjs": {
      "maxDuration": 60
    },
    "api/packs.mjs": {
      "includeFiles": "{packs/**,certs/**}"
    }
  }
}
